# ==============================================================================
# LandslideGuard AI - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` in the project root or backend directory.
# 2. Fill in the required environment variables.
# 3. NEVER commit real passwords, tokens, API keys, or database secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
PROJECT_NAME="LandslideGuard AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Environment tier: 'development' | 'staging' | 'production'
# In production: Set DEBUG=false to prevent stack trace leaks in API responses.
ENVIRONMENT="development"
DEBUG=true

# Server bind host and port (For production behind reverse proxy like Nginx, bind to 127.0.0.1 or unix socket)
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 15+)
# ------------------------------------------------------------------------------
# Format: postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
# For isolated unit tests: sqlite:///:memory: is used automatically.
DATABASE_URL="postgresql+psycopg2://landslideguard_app:YOUR_DB_PASSWORD@localhost:5432/landslideguard_db"
DATABASE_ECHO=false
DB_POOL_PRE_PING=true

# ------------------------------------------------------------------------------
# 3. CORS & NETWORK SECURITY
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins.
# In production: Restrict strictly to your authenticated frontend domain(s). Do NOT use '*'.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# 4. WEATHER PROVIDER TELEMETRY (Open-Meteo & ECMWF/GFS Analysis)
# ------------------------------------------------------------------------------
WEATHER_PROVIDER="open-meteo"
OPEN_METEO_API_URL="https://api.open-meteo.com/v1/forecast"
# Optional commercial Open-Meteo API key (leave blank for standard open access tier):
OPEN_METEO_API_KEY=""

# Telemetry network resilience & validation thresholds
WEATHER_REQUEST_TIMEOUT_SECONDS=8.0
WEATHER_MAX_RETRIES=3
WEATHER_FRESHNESS_HOURS_CURRENT=3.0
WEATHER_FRESHNESS_HOURS_STALE=24.0
WEATHER_CLOCK_SKEW_TOLERANCE_MINUTES=15.0
WEATHER_MAX_BATCH_SIZE=25

# ------------------------------------------------------------------------------
# 5. EVIDENCE & UPLOAD STORAGE
# ------------------------------------------------------------------------------
# Storage directory for field observer evidence and citizen photographs.
# Must be outside public web root and non-executable.
UPLOAD_STORAGE_DIR="uploads/evidence"
MAX_UPLOAD_SIZE_BYTES=5242880  # 5 MB maximum file size limit
ALLOWED_UPLOAD_EXTENSIONS=".jpg,.jpeg,.png,.pdf"

# ------------------------------------------------------------------------------
# 6. COMMON ALERTING PROTOCOL (CAP v1.2) & EMERGENCY SAFETY GATE
# ------------------------------------------------------------------------------
# CAP Emergency Dispatch Mode:
# During development and field trials, CAP_SIMULATION_MODE must remain TRUE.
# Live carrier broadcast or civil siren triggering is strictly disabled.
CAP_SIMULATION_MODE=true
CAP_SENDER_ID="landslideguard-ner-control@disaster.gov.in"
CAP_SCOPE="Private"

# ------------------------------------------------------------------------------
# 7. FRONTEND CLIENT CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL="http://127.0.0.1:8000"
